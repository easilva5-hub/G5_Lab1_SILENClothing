            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{prendaId}}/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{prendaId}}",
                "reviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Excelente calidad de tela\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve la reseña con rating, comment y prendaId\", () => {",
                  "  pm.expect(r.rating).to.eql(4);",
                  "  pm.expect(r.comment).to.eql(\"Excelente calidad de tela\");",
                  "  pm.expect(r.prendaId).to.eql(Number(pm.collectionVariables.get('prendaId')));",
                  "});",
                  "pm.test(\"Incluye autor {id, name} y no expone email ni password\", () => {",
                  "  pm.expect(r.user).to.have.keys(['id', 'name']);",
                  "  pm.expect(JSON.stringify(r)).not.to.include('password');",
                  "});",
                  "pm.collectionVariables.set(\"reviewId\", r.id);"
                ]
              }
            }
          ]
        },
