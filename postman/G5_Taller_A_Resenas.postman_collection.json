        {
          "name": "08 · GET reseñas paginadas (público) → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{prendaId}}/reviews?page=1&limit=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{prendaId}}",
                "reviews"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            },
            "description": "No lleva token: el listado es público."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Estructura { productId, average, total, page, limit, pages, data }\", () => {",
                  "  pm.expect(b).to.have.all.keys('productId','average','total','page','limit','pages','data');",
                  "  pm.expect(b.productId).to.eql(Number(pm.collectionVariables.get('prendaId')));",
                  "});",
                  "pm.test(\"Promedio (4 + 2) / 2 = 3 y total = 2\", () => { pm.expect(b.average).to.eql(3); pm.expect(b.total).to.eql(2); });",
                  "pm.test(\"Paginación: limit=1 → page 1 de 2\", () => { pm.expect(b.page).to.eql(1); pm.expect(b.limit).to.eql(1); pm.expect(b.pages).to.eql(2); pm.expect(b.data).to.have.length(1); });",
                  "pm.test(\"Más reciente primero (la del segundo usuario)\", () => pm.expect(b.data[0].id).to.eql(Number(pm.collectionVariables.get(\"otherReviewId\"))));",
                  "pm.test(\"Cada reseña trae su autor sin datos sensibles\", () => { pm.expect(b.data[0].user).to.have.keys([\"id\",\"name\"]); });"
                ]
              }
            }
          ]
