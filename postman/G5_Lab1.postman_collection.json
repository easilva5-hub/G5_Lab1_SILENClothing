  "item": [
    {
      "name": "1. Listar prendas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve un arreglo\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/prendas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "prendas"
          ]
        }
      }
    },
    {
      "name": "2. Crear prenda",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const item = pm.response.json();",
              "pm.test(\"Tiene id\", () => pm.expect(item.id).to.exist);",
              "pm.collectionVariables.set(\"id\", item.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/prendas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "prendas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Camiseta Oversize Blanca\",\n  \"precio\": 28,\n  \"stock\": 15,\n  \"talla\": \"M\",\n  \"categoria\": \"Camisetas\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
